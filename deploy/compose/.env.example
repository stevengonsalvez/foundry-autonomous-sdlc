# Copy to deploy/compose/.env and edit. Never commit .env (it is gitignored).
# Do NOT add COMPOSE_PROJECT_NAME here: it would override `name: sdlc-factory` in docker-compose.yml.

# live: real GitHub + agy. fake: in-process fakes, no secrets used, nothing leaves the host (smoke test).
FACTORY_MODE=live

# Host ports, bound to BIND_ADDR only. High, non-default ports so the stack sits beside others.
BIND_ADDR=127.0.0.1
TEMPORAL_HOST_PORT=17233
TEMPORAL_UI_HOST_PORT=18233
CONTROL_CENTER_HOST_PORT=18080

# Owner of secrets/*.txt on the host (`id -u`, `id -g`). worker-foreman runs as this uid so it can read
# the bind-mounted secret files, which keep their host owner and mode 0600.
FACTORY_UID=1000
FACTORY_GID=1000

# Internal-only credentials (no host port publishes Postgres or Dolt). Generate each with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=replace-with-generated-value
DOLT_ROOT_PASSWORD=replace-with-generated-value
DOLT_PASSWORD=replace-with-generated-value
# Shared by worker-foreman and coder: the coder refuses requests without it.
CODER_SERVICE_TOKEN=replace-with-generated-value

# Secret files on the host, relative to deploy/compose. See secrets/README.md.
GITHUB_PAT_HOST_FILE=./secrets/github_pat.txt
AGY_TOKEN_HOST_FILE=./secrets/agy_cli_token.txt

# 0 builds the worker image without agy (fake mode only). The coder image always installs agy.
INSTALL_AGY=1

# Pinned images (verified together in the 2026-10-20 spike).
POSTGRES_VERSION=16
TEMPORAL_VERSION=1.31.4
TEMPORAL_ADMINTOOLS_VERSION=1.31.4
TEMPORAL_UI_VERSION=2.56.0
TEMPORAL_NAMESPACE=factory
DOLT_VERSION=2.5.1
NGINX_VERSION=1.29-alpine

# 1 un-pauses the simulated product owner schedule (po-intake, every 4 h). Live mode files issues.
PO_INTAKE_ENABLED=0
