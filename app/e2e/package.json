{
  "name": "@parcel/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright golden path tests against the built web app, the API and the carrier mock.",
  "scripts": {
    "e2e": "playwright test",
    "test:history": "playwright test --config playwright.history.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0"
  }
}
